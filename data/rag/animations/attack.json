{
  "datasetFormat": "spinebones-rag-animation",
  "version": "1.0",
  "id": "attack-sword",
  "name": "Rhino Sword Attack",
  "description": "Sword slash attack for the Rhino humanoid warrior carrying a sword. The character winds up at frame 8 by pulling the sword back and leaning away, holds the windup at frame 14, then snaps forward into a fast horizontal slash at frame 20 to 24 with the upper arm rotating +85 degrees and the wrist driving the blade +45 degrees. Follow-through settles through frame 28, and the character returns to a ready stance at frame 48. Linear interpolation throughout for clean timing. The body is the root; the sword follows the right hand (bone ID 3), while the left arm counterbalances the swing.",
  "category": "attack",
  "loop": false,
  "style": [
    "stylized",
    "heavy",
    "combat"
  ],
  "motionFeatures": {
    "speed": "fast",
    "energy": "high",
    "mood": "aggressive",
    "cycle": false
  },
  "requiredBones": [
