{
  "datasetFormat": "spinebones-rag-animation",
  "version": "1.0",
  "id": "death",
  "name": "Rhino Death",
  "description": "Death and collapse animation for the Rhino humanoid warrior. The character is struck at frame 4 with a sharp shock (body jolts up, arms fly, head snaps back), then knees buckle at frame 10 as the body begins to fall. Gravity takes over from frames 16 to 24 as the body tips forward and rotates 82 degrees while dropping 38 units toward the ground. The body lands at frame 30 with a slight bounce, slides and settles through frame 36, and comes to complete rest at frame 42 with all limbs limp. The sword collapses with the right hand. Gravity easing (easeIn) accelerates the fall; impact easing (easeOut) decelerates the landing.",
  "category": "death",
  "loop": false,
  "style": [
    "stylized",
    "heavy",
    "dramatic"
  ],
  "motionFeatures": {
    "speed": "fast",
