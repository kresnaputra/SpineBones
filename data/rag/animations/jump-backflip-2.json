{
  "datasetFormat": "spinebones-rag-animation",
  "version": "1.0",
  "id": "jump-backflip",
  "name": "Rhino Jump Backflip",
  "description": "In-place backward somersault for the Rhino humanoid warrior carrying a sword. The character crouches at frame 10, launches upward by frame 20, tucks into a backward rotation through frames 26 to 44, extends for landing at frame 50, absorbs the impact at frame 54, and returns to a standing pose at frame 72. The body root completes one full backward revolution, ending at -360 degrees. The head, arms, and legs follow the body; the eyes follow the head and the sword follows the right hand.",
  "category": "jump",
  "loop": true,
  "style": [
    "stylized",
    "acrobatic",
    "heavy",
    "combat"
  ],
  "motionFeatures": {
